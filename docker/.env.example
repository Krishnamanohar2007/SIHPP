# Local Docker Compose settings. Copy to docker/.env; do not commit real passwords.
POSTGRES_DB=risk_monitor
POSTGRES_USER=risk_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080
ENVIRONMENT=development
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.gov.in
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
NOTIFICATION_CHANNELS=console
NOTIFICATION_RISK_THRESHOLD=60
NOTIFICATION_RECIPIENT=risk-operations@example.invalid
NOTIFICATION_SCAN_INTERVAL_MINUTES=15
RUN_MIGRATIONS=true
SEED_SAMPLE_DATA=true
VITE_API_BASE_URL=/api
# Hours between automatic retraining runs. 0 disables scheduled retraining.
RETRAIN_INTERVAL_HOURS=0
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
