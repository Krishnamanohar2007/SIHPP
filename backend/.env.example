APP_NAME=Land Acquisition Risk Monitor API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://risk_user:risk_password@localhost:5432/risk_monitor
NOTIFICATION_CHANNELS=console,sms,email,push
NOTIFICATION_RISK_THRESHOLD=60
NOTIFICATION_RECIPIENT=risk-operations@example.invalid
NOTIFICATION_SCAN_INTERVAL_MINUTES=15
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.gov.in
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
RETRAIN_INTERVAL_HOURS=0
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
